# Copy to .env (gitignored) for local runs: `set -a; source .env; set +a`
# On CAI, set these as project environment variables instead.
SPEND_IMPALA_USER=your-workload-username
SPEND_IMPALA_PASSWORD=your-workload-password
HF_HOME=.hf_cache

# Air-gapped: a folder holding both downloaded models
# (hf download sentence-transformers/all-MiniLM-L6-v2 / amazon/chronos-2)
# SPEND_MODEL_LOCAL_DIR=/home/cdsw/models

# CAI workbench (also the Airflow Variable SPEND_CAI_HOST that triggers the CAI jobs)
SPEND_CAI_HOST=https://federal-cml.federal.dp5i-5vkq.cloudera.site
# SPEND_CAI_API_KEY=              # CAI API v2 key: User Settings > API Keys (never commit)

# After the CAI model is deployed (Customer 360, what-if and the Categoriser tab)
# SPEND_ENDPOINT_URL=https://modelservice.federal-cml.federal.dp5i-5vkq.cloudera.site/model
# SPEND_ENDPOINT_ACCESS_KEY=
# SPEND_ENDPOINT_API_KEY=
